{
  "name": "solarclient",
  "productName": "SolarClient",
  "version": "3.20.21",
  "description": "SolarClient - a Minecraft launcher",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/brand-dev.js && electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "brand": "node scripts/brand-dev.js",
    "postinstall": "node scripts/brand-dev.js"
  },
  "author": "SolarClient",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.7",
    "minecraft-launcher-core": "^3.18.2",
    "minecraft-protocol": "^1.51.0",
    "msmc": "^5.0.5",
    "screenshot-desktop": "^1.15.6",
    "tar": "^7.4.3",
    "ws": "^8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SolarClient/SolarClient.git"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.solarclient.launcher",
    "productName": "SolarClient",
    "publish": {
      "provider": "github",
      "owner": "sharktoothgaming56-maker",
      "repo": "solarclientsite",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json",
      "scripts/**/*",
      "tools/**/*",
      "!backend/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/docs/**",
      "!**/example/**",
      "!**/examples/**",
      "!**/.github/**",
      "!**/*.d.ts",
      "!tools/rcedit-x64.exe",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/ws/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "SolarClient",
      "legalTrademarks": "SolarClient"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "artifactName": "${productName}-${version}.${ext}",
    "compression": "maximum",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SolarClient",
      "artifactName": "SolarClient-Setup-${version}.${ext}"
    }
  }
}
